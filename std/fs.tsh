type FileMode = int

type FileInfo struct {
	name string
}

func (fi FileInfo) Name() string {
	return fi.name
}

type DirEntry struct {
	name  string
	isDir bool
	info FileInfo
}

func NewDirEntry(name string, isDir bool) DirEntry {
	return DirEntry{
		name: name,
		isDir: isDir,
	}
}

func (de DirEntry) Name() string {
	return de.name
}

func (de DirEntry) IsDir() bool {
	return de.isDir
}

func (de DirEntry) Info() (FileInfo, error) {
	return FileInfo{}, nil
}
